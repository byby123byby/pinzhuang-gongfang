      "tools": "尖锥、十字螺丝刀；墙端按墙体选择",
      "parts": [
        "102646",
        "108458"
      ]
    },
    {
      "route": "门与搁板",
      "printed_step": 2,
      "page": 17,
      "action": "将四个铰杯分别嵌入两扇门内侧的圆形沉孔，每扇门两个。每个铰杯用两颗螺钉固定。",
      "tools": "手、十字螺丝刀",
      "parts": [
        "109336",
        "100344"
      ]
    },
    {
      "route": "门与搁板",
      "printed_step": 3,
      "page": 17,
      "action": "托住柜门，使铰臂长孔对上底座螺钉，沿底座滑入，再拧紧锁定螺钉。两扇门共接合四处。",
      "tools": "手、十字螺丝刀",
      "parts": [
        "109336",
        "109220"
      ]
    },
    {
      "route": "门与搁板",
      "printed_step": 4,
      "page": 18,
      "action": "在选好的两层高度分别插入四个托销，把两块搁板各自水平放下。",
      "tools": "手",
      "parts": [
        "101532"
      ]
    }
