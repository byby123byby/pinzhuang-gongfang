      "tools": "手、十字螺丝刀",
      "parts": [
        "100404"
      ]
    },
    {
      "route": "装入侧架",
      "printed_step": 3,
      "page": 14,
      "action": "在柜顶上方定位两个上支托，标孔并拧紧支托螺钉。上支托的螺钉位置在托面上方。",
      "tools": "手、尖锥、十字螺丝刀",
      "parts": [
        "10095544",
        "109560"
      ]
    },
    {
      "route": "装入侧架",
      "printed_step": 4,
      "page": 15,
      "action": "从两个上支托的托面向下拧入柜顶连接螺钉。",
      "tools": "十字螺丝刀",
      "parts": [
        "100404"
      ]
    },
    {
      "route": "侧架防倾倒",
      "printed_step": 1,
      "page": 16,
